# Contoh variabel lingkungan. SALIN NAMANYA ke Netlify:
#   Site configuration > Environment variables
# JANGAN isi nilai asli di file ini, dan JANGAN commit file .env asli.

# --- Firebase Admin (Firebase Console > Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=isi-dengan-project_id
FIREBASE_CLIENT_EMAIL=isi-dengan-client_email
# Salin private_key persis, termasuk -----BEGIN... dan tanda \n di dalamnya
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Cloudinary (Cloudinary Dashboard > Settings > API Keys)
CLOUDINARY_CLOUD_NAME=isi-dengan-cloud-name
CLOUDINARY_API_KEY=isi-dengan-api-key
CLOUDINARY_API_SECRET=isi-dengan-api-secret

# --- Opsional: alamat situs utama untuk RSS, sitemap, dan meta tag.
# Kalau kosong, dipakai alamat dari Netlify. Isi bila memakai domain sendiri.
SITE_URL=https://riakata.my.id
